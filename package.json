{
  "name": "money-sim",
  "version": "0.2.0",
  "description": "Money Sim: gamified saving and investing education with virtual money, a portfolio and a trading simulator",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --mode admin --port 5175",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:admin": "tsc --noEmit && vite build --mode admin --outDir dist-admin",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts",
    "build:single:admin": "tsc --noEmit && vite build --config vite.single.config.ts --mode admin --outDir dist-single-admin",
    "build:all": "npm run build && npm run build:admin",
    "preview": "vite preview",
    "preview:admin": "vite preview --outDir dist-admin --port 4175",
    "ios": "npm run build && cap sync ios && cap open ios",
    "ios:sync": "npm run build && cap sync ios"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": "true",
  "type": "module",
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
